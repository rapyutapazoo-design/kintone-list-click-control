{
  "name": "kintone-list-click-plugin",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.2"
  },
  "kintone": {
    "pluginId": "neklemabkagehjpmnoefjaafoojchelp"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
